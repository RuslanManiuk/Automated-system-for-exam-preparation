# Приклад .env файлу для ExamNinja
NODE_ENV=development

PORT=5000

MONGODB_URI=mongodb://admin:examninja_secure_password_2025@localhost:27017/examninja?authSource=admin

JWT_SECRET=your_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRE=7d

SESSION_SECRET=your_session_secret_change_in_production_2025

CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GEMINI_API_KEY=your_gemini_api_key_here

GROK_API_KEY=your_grok_api_key_here

OPENROUTER_API_KEY=your_openrouter_api_key_here

MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
